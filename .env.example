# Public site URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Server-side key for Google Places API review pulls. Prefer this over the public browser key.
GOOGLE_PLACES_API_KEY=""
# Optional but recommended. If blank, the app will try Places Text Search by name/address.
GOOGLE_PARTRIDGE_CREEK_PLACE_ID=""
GOOGLE_GREAT_LAKES_PLACE_ID=""

# Shopify Storefront API
# Use your permanent *.myshopify.com domain here, not a custom storefront domain.
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
# Optional: defaults to the current scaffold target.
SHOPIFY_STOREFRONT_API_VERSION="2026-01"
# Optional: Shopify-hosted sign-in/create-account URL. If blank, the app uses https://SHOPIFY_STORE_DOMAIN/account.
SHOPIFY_CUSTOMER_ACCOUNT_URL=""

# TinaCMS / TinaCloud
NEXT_PUBLIC_TINA_CLIENT_ID=""
TINA_TOKEN=""
NEXT_PUBLIC_TINA_BRANCH="main"
# Optional: only needed if TinaCloud search is enabled.
TINA_SEARCH_TOKEN=""

# SMTP
# Leave SMTP_HOST / SMTP_USER / SMTP_PASS blank in local dev if you only want submissions logged.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="J. Barbaro Clothiers <no-reply@your-domain.com>"
SMTP_REPLY_TO="support@your-domain.com"

# Internal notification recipients
# Comma-separated values are supported.
APPOINTMENT_NOTIFICATION_TO="appointments@your-domain.com"
CONTACT_NOTIFICATION_TO="support@your-domain.com"
WEDDING_NOTIFICATION_TO="weddings@your-domain.com"
